# Root Compose orchestration. Project-local examples live in web/ and backend/.

# Host ports
APP_PORT=3218
API_PORT=3219
HTTPS_PORT=3443
API_HTTPS_PORT=3444
POSTGRES_PORT=5432

# Standalone localhost pair. LAN helpers replace both with one detected hostname.
# The API origin is included so Swagger "Try it out" can send mutations.
PUBLIC_API_BASE_URL=http://localhost:3219
CORS_ALLOWED_ORIGINS=http://localhost:3218,http://localhost:3219

# Backend HttpOnly session cookie. HTTPS deployment overrides SECURE to true.
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAME_SITE=lax
SESSION_COOKIE_DOMAIN=

# Backend-owned persistent host paths
UPLOADS_HOST_DIR=./.data/uploads
UPLOADS_DIR=/app/uploads
WHISPER_TOOLS_HOST_DIR=./backend/tools

# Backend AI services
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=gemma4:31b-cloud
OLLAMA_THINKING_MODEL=true
AI_ANALYSIS_CONCURRENCY=3

# Server-only Cartesia configuration. Never expose the key to web/.
CARTESIA_API_KEY=
CARTESIA_VOICE_ID=
CARTESIA_MODEL=sonic-3.6
CARTESIA_API_URL=https://api.cartesia.ai/tts/bytes
CARTESIA_API_VERSION=2026-08-14

# Backend Whisper runtime
WHISPER_BACKEND=openai
WHISPER_PYTHON_BIN=/opt/whisper/bin/python
WHISPER_OPENAI_MODEL=base
WHISPER_OPENAI_MODEL_DIR=/app/tools/whisper/openai-models
WHISPER_OPENAI_CACHE_DIR=/app/tools/whisper/cache
WHISPER_FFMPEG_BIN=/usr/bin/ffmpeg
WHISPER_OPENAI_DEVICE=cpu
WHISPER_OPENAI_FP16=false
WHISPER_LANGUAGE=auto
