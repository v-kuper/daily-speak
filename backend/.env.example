# API listener and PostgreSQL
APP_ADDR=:3219
DATABASE_URL=postgres://postgres:postgres@localhost:5432/daily_speaking
# Local Docker/PostgreSQL can use false. Production: set true and use
# DATABASE_URL with sslmode=verify-full and a trusted PostgreSQL certificate.
DATABASE_SSL=false
SERVER_LOG_LEVEL=info

# Exact web and Swagger API origins; never use * with credentialed requests.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3219

# HttpOnly browser refresh cookie for the unified v1 identity contract.
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAME_SITE=lax
SESSION_COOKIE_DOMAIN=

# Unified web/mobile identity. Generate the secret outside the repository, for example:
# openssl rand -base64 48
AUTH_ACCESS_TOKEN_SECRET=
AUTH_ACCESS_TOKEN_ISSUER=daily-speaking-api
AUTH_ACCESS_TOKEN_AUDIENCE=daily-speaking-mobile
AUTH_ACCESS_TOKEN_TTL=15m
AUTH_REFRESH_TOKEN_TTL=720h
AUTH_GUEST_TOKEN_TTL=24h

# Operations. Trust only the actual reverse-proxy network in deployment.
TRUSTED_PROXY_CIDRS=
RATE_LIMIT_ENABLED=true
RATE_LIMIT_AUTH_REQUESTS=20
RATE_LIMIT_AUTH_WINDOW=1m
RATE_LIMIT_WRITE_REQUESTS=120
RATE_LIMIT_WRITE_WINDOW=1m
RATE_LIMIT_EXPENSIVE_REQUESTS=20
RATE_LIMIT_EXPENSIVE_WINDOW=1h
READINESS_TIMEOUT=2s
READINESS_MAX_QUEUE_DEPTH=1000
READINESS_MAX_OLDEST_JOB_AGE=30m
# Empty disables /metrics. Keep a configured value in a secret store.
METRICS_BEARER_TOKEN=

# Paths are relative to backend/ when running go run from this directory.
UPLOADS_DIR=public/uploads

# Media storage defaults to the private local UPLOADS_DIR mount.
# Configure the S3-compatible values only when explicitly selecting `s3`.
# Keep access keys and session tokens in a server-side secret store.
MEDIA_STORAGE_DRIVER=local
MEDIA_S3_REGION=
MEDIA_S3_BUCKET=
MEDIA_S3_ENDPOINT=
MEDIA_S3_FORCE_PATH_STYLE=false
MEDIA_S3_ACCESS_KEY_ID=
MEDIA_S3_SECRET_ACCESS_KEY=
MEDIA_S3_SESSION_TOKEN=
MEDIA_UPLOAD_URL_TTL=15m
MEDIA_MULTIPART_PART_SIZE_BYTES=8388608
MEDIA_SWEEP_INTERVAL=15m

# Ollama and analysis
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gemma4:31b-cloud
OLLAMA_THINKING_MODEL=true
AI_ANALYSIS_CONCURRENCY=3

# Durable worker pools. Keep heartbeat shorter than the lease.
GUEST_PREVIEW_QUEUE_CAPACITY=100
WORKER_RECORDING_CONCURRENCY=1
WORKER_GUEST_PREVIEW_CONCURRENCY=1
WORKER_SHADOWING_CONCURRENCY=2
WORKER_CLEANUP_CONCURRENCY=2
WORKER_POLL_INTERVAL=1s
WORKER_LEASE_DURATION=2m
WORKER_HEARTBEAT_INTERVAL=30s
WORKER_RETRY_BASE_DELAY=5s
WORKER_RETRY_MAX_DELAY=5m
WORKER_JOB_RETENTION=720h

# Server-only Groq transcription
GROQ_API_KEY=
GROQ_WHISPER_MODEL=whisper-large-v3-turbo
TRANSCRIPTION_LANGUAGE=auto
TRANSCRIPTION_PROMPT=
FFMPEG_BINARY_PATH=ffmpeg
# Optional explicit ffprobe path. By default it is resolved next to ffmpeg.
FFPROBE_BINARY_PATH=

# Server-only Cartesia configuration. Keep CARTESIA_API_KEY secret.
CARTESIA_API_KEY=
CARTESIA_VOICE_ID=
CARTESIA_MODEL=sonic-3.6
CARTESIA_API_URL=https://api.cartesia.ai/tts/bytes
CARTESIA_API_VERSION=2026-08-14
