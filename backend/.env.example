# API listener and PostgreSQL
APP_ADDR=:3219
DATABASE_URL=postgres://postgres:postgres@localhost:5432/daily_speaking
DATABASE_SSL=false
SERVER_LOG_LEVEL=info

# Exact browser origins; never use * with credentialed requests.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Current PostgreSQL-backed HttpOnly session cookie.
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAME_SITE=lax
SESSION_COOKIE_DOMAIN=

# Paths are relative to backend/ when running go run from this directory.
UPLOADS_DIR=public/uploads

# Ollama and analysis
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gemma4:31b-cloud
OLLAMA_THINKING_MODEL=true
AI_ANALYSIS_CONCURRENCY=3

# Local Python Whisper
WHISPER_BACKEND=openai
WHISPER_PYTHON_BIN=.venv/bin/python
WHISPER_OPENAI_MODEL=base
WHISPER_OPENAI_MODEL_DIR=tools/whisper/openai-models
WHISPER_OPENAI_CACHE_DIR=tools/whisper/cache
WHISPER_FFMPEG_BIN=tools/ffmpeg/bin/ffmpeg
WHISPER_OPENAI_DEVICE=cpu
WHISPER_OPENAI_FP16=false
WHISPER_LANGUAGE=auto
WHISPER_THREADS=4
WHISPER_TIMEOUT_MS=180000

# Alternative whisper.cpp configuration (set WHISPER_BACKEND=cpp).
WHISPER_BINARY_PATH=
WHISPER_MODEL_PATH=

# Server-only Cartesia configuration. Keep CARTESIA_API_KEY secret.
CARTESIA_API_KEY=
CARTESIA_VOICE_ID=
CARTESIA_MODEL=sonic-3.6
CARTESIA_API_URL=https://api.cartesia.ai/tts/bytes
CARTESIA_API_VERSION=2026-08-14
